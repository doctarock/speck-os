# /etc/speck-os/broker.env
SPECK_BROKER_SOCKET=/run/speck-broker/broker.sock
SPECK_SERVICE_USER=speck
SPECK_HEALTH_URL=http://127.0.0.1:4310/api/health
# Units that must be active for a boot to count as healthy (provisioning adds speck-kiosk.service).
SPECK_HEALTH_UNITS="speck-broker.service speck.service"
# How long the system must stay healthy after a change before it becomes the boot fallback.
SPECK_SETTLE_SEC=600
SPECK_BROKER_SNAPSHOTS=auto
