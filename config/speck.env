# /etc/speck-os/speck.env: Speck service environment.
# State lives outside the code slot so A/B updates never touch it.
NODE_ENV=production
SPECK_HOST=127.0.0.1
SPECK_PORT=4310
SPECK_DB_PATH=/var/lib/speck/speck.sqlite
SPECK_GENESIS_RUNTIME_PATH=/var/lib/speck/genesis-runtime
SPECK_GENESIS_PROFILE=speck-os
SPECK_EMBEDDING_ENABLED=true
SPECK_EMBEDDING_PROVIDER=llama.cpp
SPECK_EMBEDDING_BASE_URL=http://127.0.0.1:8083
SPECK_EMBEDDING_MODEL=nomic-embed-text-v1.5
SPECK_EMBEDDING_DIMENSIONS=768
