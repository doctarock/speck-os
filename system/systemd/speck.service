[Unit]
# Not on the USB installer, which only runs the Install screen.
ConditionPathExists=!/etc/speck-os/installer
Description=Speck cognitive runtime (Genesis host)
After=network-online.target infer@worker.service
Wants=network-online.target infer@worker.service infer@intake.service infer@toolcaller.service infer@embed.service

[Service]
Type=simple
User=speck
Group=speck
# /opt/speck/current is a symlink to the active slot (A/B updates in phase 2).
WorkingDirectory=/opt/speck/current
EnvironmentFile=/etc/speck-os/speck.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
