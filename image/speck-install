#!/usr/bin/env bash
# speck-install: put Speck OS on a disk, with the layout boot rollback depends on.
#
#   speck-install --target <disk> --from-tar <root.tar[.zst]> [--removable] [--installer-media] --yes
#       build time (image/build.sh): write an image from the root tree mkosi built
#   speck-install --target <disk> --from-running --yes
#       on the USB installer (first-boot setup's Install step): copy this running system onto <disk>
#
# Layout (the same one provision/phase1.sh converts a hand-installed box to):
#   p1  EFI    512 MiB  vfat   shim + Ubuntu-signed GRUB, so Secure Boot works with Microsoft's keys
#   p2  boot   2 GiB    ext4   kernels, grub.cfg, grubenv (GRUB can write its boot counter on ext4, not btrfs)
#   p3  root   rest     btrfs  @ (system)  @speck (agent state)  @speck-infer (models)  @snapshots
#
# Options:
#   --removable        firmware fallback path only (EFI/BOOT/BOOTX64.EFI); never touch NVRAM boot entries
#   --installer-media  the result is a USB installer: boots into the Install screen, runs no agent
#   --hostname <name>  default: speck
#
# Progress for the setup page: lines "@@ <percent> <message>".
set -euo pipefail

TARGET="" SOURCE="" TARBALL="" REMOVABLE=0 MEDIA=0 YES=0 HOSTNAME_=speck
while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET=$2; shift 2 ;;
    --from-tar) SOURCE=tar; TARBALL=$2; shift 2 ;;
    --from-running) SOURCE=running; shift ;;
    --removable) REMOVABLE=1; shift ;;
    --installer-media) MEDIA=1; shift ;;
    --hostname) HOSTNAME_=$2; shift 2 ;;
    --yes) YES=1; shift ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
done

progress() { echo "@@ $1 $2"; }
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root"
[ -n "$TARGET" ] && [ -n "$SOURCE" ] || die "usage: speck-install --target <disk> (--from-tar <file> | --from-running) --yes"
[ -b "$TARGET" ] || die "$TARGET is not a block device"
[ "$YES" = 1 ] || die "this erases $TARGET; pass --yes"
[ "$SOURCE" != tar ] || [ -f "$TARBALL" ] || die "no such file: $TARBALL"

WORK=$(mktemp -d /run/speck-install.XXXXXX)
TOP=$WORK/top
R=$WORK/root
cleanup() {
  set +e
  sync
  for m in $(findmnt -rn -o TARGET | grep "^$WORK" | sort -r); do umount -l "$m" 2>/dev/null; done
  rmdir "$TOP" "$R" "$WORK" 2>/dev/null
}
trap cleanup EXIT

# nvme0n1 → nvme0n1p1, loop0 → loop0p1, sda → sda1
part() { case "$1" in *[0-9]) echo "${1}p$2" ;; *) echo "$1$2" ;; esac; }
# Containers have no udev: create partition nodes from sysfs when they don't appear.
ensure_node() {
  local dev=$1 name sys
  name=$(basename "$dev")
  for _ in $(seq 1 50); do [ -b "$dev" ] && return 0; sleep 0.1; done
  sys=/sys/class/block/$name/dev
  [ -f "$sys" ] || die "$dev did not appear"
  mknod "$dev" b "$(cut -d: -f1 "$sys")" "$(cut -d: -f2 "$sys")"
}

# ---------------------------------------------------------------- checks
progress 2 "Checking the disk"
ROOT_SRC=$(findmnt -no SOURCE / | sed 's/\[.*\]$//')
ROOT_DISK=$(lsblk -no PKNAME "$ROOT_SRC" 2>/dev/null | head -1 || true)
[ "/dev/$ROOT_DISK" != "$TARGET" ] || die "$TARGET holds the running system"
if lsblk -nrpo NAME "$TARGET" | tail -n +2 | while read -r p; do findmnt -rn -S "$p" >/dev/null && exit 1; done; then :; else
  die "a partition of $TARGET is mounted"
fi
SIZE=$(blockdev --getsize64 "$TARGET")
MIN_GIB=24; [ "$MEDIA" = 1 ] && MIN_GIB=8   # installer media only needs to fit the system
[ "$SIZE" -ge $((MIN_GIB * 1024 * 1024 * 1024)) ] || die "$TARGET is too small ($((SIZE / 1000000000)) GB)"

# ---------------------------------------------------------------- partitions + filesystems
progress 5 "Partitioning $TARGET"
wipefs -aq "$TARGET"
sgdisk --zap-all "$TARGET" >/dev/null
sgdisk -n1:1MiB:+512MiB -t1:EF00 -c1:EFI \
       -n2:0:+2GiB      -t2:8300 -c2:speck-boot \
       -n3:0:0          -t3:8300 -c3:speck-root "$TARGET" >/dev/null
partprobe "$TARGET" 2>/dev/null || blockdev --rereadpt "$TARGET" 2>/dev/null || true
udevadm settle 2>/dev/null || true
P1=$(part "$TARGET" 1) P2=$(part "$TARGET" 2) P3=$(part "$TARGET" 3)
for p in "$P1" "$P2" "$P3"; do ensure_node "$p"; done

progress 10 "Creating filesystems"
mkfs.vfat -F 32 -n EFI "$P1" >/dev/null
mkfs.ext4 -q -F -L speck-boot "$P2"
mkfs.btrfs -q -f -L speck-root "$P3"
EFI_UUID=$(blkid -s UUID -o value "$P1")
BOOT_UUID=$(blkid -s UUID -o value "$P2")
ROOT_UUID=$(blkid -s UUID -o value "$P3")

mkdir -p "$TOP" "$R"
mount -o subvolid=5 "$P3" "$TOP"
for sv in @ @speck @speck-infer @snapshots; do btrfs subvolume create "$TOP/$sv" >/dev/null; done
mount -o subvol=@,noatime "$P3" "$R"
mkdir -p "$R/boot" "$R/var/lib/speck" "$R/var/lib/speck-infer" "$R/.snapshots"
mount "$P2" "$R/boot"
mkdir -p "$R/boot/efi"
mount "$P1" "$R/boot/efi"
mount -o subvol=@speck,noatime "$P3" "$R/var/lib/speck"
mount -o subvol=@speck-infer,noatime "$P3" "$R/var/lib/speck-infer"
mount -o subvol=@snapshots,noatime "$P3" "$R/.snapshots"
mkdir -p "$R/var/lib/speck-infer/models"
chattr +C "$R/var/lib/speck-infer/models" 2>/dev/null || true   # no COW for multi-GB model files

# ---------------------------------------------------------------- copy the system
if [ "$SOURCE" = tar ]; then
  progress 15 "Copying the system"
  case "$TARBALL" in
    *.zst) zstd -dc -T0 "$TARBALL" ;;
    *.gz) gzip -dc "$TARBALL" ;;
    *) cat "$TARBALL" ;;
  esac | tar -x -p --numeric-owner --xattrs --xattrs-include='*' --acls -C "$R"
else
  # From the running USB system: root, agent state, models, kernels. rsync reports progress.
  # Each source gets a share of 15–85 % by size.
  SOURCES=("/" "/var/lib/speck/" "/var/lib/speck-infer/" "/boot/")
  DESTS=("$R/" "$R/var/lib/speck/" "$R/var/lib/speck-infer/" "$R/boot/")
  SIZES=() TOTAL=0
  for s in "${SOURCES[@]}"; do b=$(du -sxb "$s" 2>/dev/null | cut -f1); b=${b:-1}; SIZES+=("$b"); TOTAL=$((TOTAL + b)); done
  DONE=0
  for i in "${!SOURCES[@]}"; do
    base=$((15 + 70 * DONE / TOTAL)); span=$((70 * SIZES[i] / TOTAL))
    progress "$base" "Copying the system"
    rsync -aHAXx --numeric-ids --no-inc-recursive --info=progress2 \
      --exclude=/efi --exclude=/grub --exclude=/speck-good \
      --exclude=/tmp/ --exclude=/var/tmp/ --exclude=/var/log/journal/ --exclude=/var/cache/apt/archives/ --exclude=/swap.img \
      "${SOURCES[i]}" "${DESTS[i]}" |
      tr '\r' '\n' | while read -r line; do
        pct=$(printf '%s\n' "$line" | sed -n 's/.* \([0-9]\{1,3\}\)% .*/\1/p')
        [ -n "$pct" ] && echo "@@ $((base + span * pct / 100)) Copying the system"
      done
    DONE=$((DONE + SIZES[i]))
  done
  mkdir -p "$R/tmp" "$R/var/tmp" "$R/var/log/journal" && chmod 1777 "$R/tmp" "$R/var/tmp"
fi

# Media written from a build carries the installer that wrote it, so a stick never installs with
# an older speck-install than the one that made it.
if [ "$SOURCE" = tar ]; then
  install -D -m 0755 "$(readlink -f "$0")" "$R/usr/lib/speck-os/speck-install"
fi

# ---------------------------------------------------------------- configure
progress 86 "Configuring"
cat > "$R/etc/fstab" <<EOF
# Speck OS. The root subvolume is chosen by GRUB (rootflags=subvol=@, or @good for the fallback).
UUID=$ROOT_UUID  /                    btrfs  defaults,noatime                0 0
UUID=$ROOT_UUID  /var/lib/speck       btrfs  subvol=@speck,defaults,noatime  0 0
UUID=$ROOT_UUID  /var/lib/speck-infer btrfs  subvol=@speck-infer,defaults,noatime 0 0
UUID=$ROOT_UUID  /.snapshots          btrfs  subvol=@snapshots,defaults,noatime 0 0
UUID=$BOOT_UUID  /boot                ext4   defaults                        0 2
UUID=$EFI_UUID   /boot/efi            vfat   umask=0077                      0 1
EOF
echo "$HOSTNAME_" > "$R/etc/hostname"
grep -q "127.0.1.1" "$R/etc/hosts" 2>/dev/null && sed -i "s/^127\.0\.1\.1.*/127.0.1.1 $HOSTNAME_/" "$R/etc/hosts" || echo "127.0.1.1 $HOSTNAME_" >> "$R/etc/hosts"
# Each install is its own machine: systemd makes a new machine-id at first boot.
: > "$R/etc/machine-id"
rm -f "$R/var/lib/dbus/machine-id"
rm -rf "$R/var/lib/speck-ui/.config/speck-kiosk"   # the installer's kiosk profile

# Snapper (what `snapper create-config` would write, without needing D-Bus in a chroot).
if [ -f "$R/usr/share/snapper/config-templates/default" ]; then
  install -d "$R/etc/snapper/configs"
  sed -e 's/^SUBVOLUME=.*/SUBVOLUME="\/"/' -e 's/^FSTYPE=.*/FSTYPE="btrfs"/' \
      -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="60"/' -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="10"/' \
      -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
      "$R/usr/share/snapper/config-templates/default" > "$R/etc/snapper/configs/root"
  if grep -q '^SNAPPER_CONFIGS=' "$R/etc/default/snapper" 2>/dev/null; then
    sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' "$R/etc/default/snapper"
  else
    echo 'SNAPPER_CONFIGS="root"' >> "$R/etc/default/snapper"
  fi
  chmod 750 "$R/.snapshots"
  systemctl --root="$R" disable snapper-timeline.timer >/dev/null 2>&1 || true
  systemctl --root="$R" enable snapper-cleanup.timer >/dev/null 2>&1 || true
fi

# Installer media runs only the Install screen: Speck, the workers, speck-hwd and the boot counter
# have ConditionPathExists=!/etc/speck-os/installer. An installed system runs everything.
if [ "$MEDIA" = 1 ]; then
  install -d "$R/etc/speck-os" && : > "$R/etc/speck-os/installer"
  chmod -x "$R/etc/grub.d/09_speck-bootcount" "$R/etc/grub.d/42_speck-good" 2>/dev/null || true
else
  rm -f "$R/etc/speck-os/installer"
  chmod +x "$R/etc/grub.d/09_speck-bootcount" "$R/etc/grub.d/42_speck-good" 2>/dev/null || true
  rm -f "$R/var/lib/speck/.broker/setup.json"   # first boot shows setup
fi

# ---------------------------------------------------------------- bootloader
progress 90 "Installing the bootloader"
for d in dev proc sys run; do mount --rbind "/$d" "$R/$d"; mount --make-rslave "$R/$d"; done
# GRUB writes root=UUID=… only if /dev/disk/by-uuid has the disk; without udev (building in a
# container) it would write the build machine's device name (e.g. /dev/loop4p3) and never boot.
mkdir -p /dev/disk/by-uuid
for p in "$P1" "$P2" "$P3"; do
  u=$(blkid -s UUID -o value "$p")
  [ -e "/dev/disk/by-uuid/$u" ] || ln -s "$p" "/dev/disk/by-uuid/$u"
done
NVRAM=(--no-nvram)
[ "$REMOVABLE" = 0 ] && [ -d /sys/firmware/efi/efivars ] && NVRAM=()
# The named entry (EFI/ubuntu, which also holds the grub.cfg stub the signed GRUB looks for) and the
# firmware fallback path, so a mini PC that forgets its boot entries still finds the disk.
chroot "$R" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=ubuntu --uefi-secure-boot "${NVRAM[@]}"
chroot "$R" grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot --removable --no-nvram
[ -f "$R/boot/grub/grubenv" ] || chroot "$R" grub-editenv /boot/grub/grubenv create
chroot "$R" update-grub
grep -q 'rootflags=subvol=@' "$R/boot/grub/grub.cfg" || die "grub.cfg does not boot subvolume @"
grep -q "root=UUID=$ROOT_UUID" "$R/boot/grub/grub.cfg" || die "grub.cfg does not find the root filesystem by UUID"

progress 98 "Finishing"
sync
progress 100 "Installed"
